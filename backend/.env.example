# LDB Authentication — set ONE of these:

# Option 1 (preferred): RDM consumer key from raildata.org.uk
RDM_API_KEY=your-consumer-key-here

# Option 2 (alternative): Direct SOAP token from realtime.nationalrail.co.uk
# NR_TOKEN_SV=your-soap-token-here

# API port
PORT=3000

# Optional: Schedule file path (CIF JSON, supports .gz)
# SCHEDULE_FILE=./data/schedule.json.gz

# Phase 2: TD Kafka credentials (from RDM subscription)
# TD_KAFKA_BROKERS=
# TD_KAFKA_GROUP=
# TD_KAFKA_USERNAME=
# TD_KAFKA_PASSWORD=
# TD_KAFKA_TOPIC=
