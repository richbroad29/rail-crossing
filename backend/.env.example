# LDB Authentication — set ONE of these:

# Option 1 (preferred): RDM consumer key from raildata.org.uk (LDBSVWS via REST)
RDM_API_KEY=your-consumer-key-here

# Option 2 (alternative): direct SOAP token from realtime.nationalrail.co.uk
# NR_TOKEN_SV=your-soap-token-here

# NROD feed credentials — one login covers CIF SCHEDULE, CORPUS, and the TD STOMP
# feed (all on publicdatafeeds.networkrail.co.uk, same basic auth).
NR_FEED_USER=your-nrod-email
NR_FEED_PASS=your-nrod-password

# API port
PORT=3000

# Optional: override the CIF schedule file path
# (default: ./data/schedule/cif-latest.json.gz, auto-downloaded)
# SCHEDULE_FILE=./data/schedule.json.gz
