# Copy this file to boards-server/.env and fill in the key. .env is never committed.

# Consumer key for the "Live Departure Board" product on raildata.org.uk (free).
RDM_DEPARTURES_KEY=paste-your-key-here

# The product's endpoint, everything up to and including GetDepBoardWithDetails.
# Copy it from the product's page on raildata.org.uk; the line below is a best guess.
RDM_DEPARTURES_URL=https://api1.raildata.org.uk/1010-live-departure-board-dep1_2/LDBWS/api/20220120/GetDepBoardWithDetails

# Port for http://localhost:<PORT>/ (default 8080)
# PORT=8080
